# Copy these into your Vercel project settings (Environment Variables)
# and into a local .env file for development.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-side only (API routes / service tasks). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin account bootstrap (used by schema.sql trigger defaults)
ADMIN_EMAIL=atltravels@hotmail.com
